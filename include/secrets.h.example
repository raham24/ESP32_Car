// Copy this file to include/secrets.h and fill in your network details.
// secrets.h is gitignored so your credentials never get committed.
#pragma once

// Network name (used for both modes)
#define WIFI_SSID "YourNetworkName"

// Set to 1 for WPA2-Enterprise networks (university / office WiFi that asks
// for a username AND password). Set to 0 for a normal home network that only
// asks for a password.
#define WIFI_ENTERPRISE 0

// --- Regular WPA/WPA2 (WIFI_ENTERPRISE == 0) ---
#define WIFI_PASSWORD "YourPassword"

// --- WPA2-Enterprise (WIFI_ENTERPRISE == 1) ---
// Most networks use PEAP/MSCHAPv2 with a username and password.
// Identity is usually the same as the username; leave it identical unless
// your network tells you otherwise (some use an "anonymous" outer identity).
#define WIFI_EAP_IDENTITY "your.username"
#define WIFI_EAP_USERNAME "your.username"
#define WIFI_EAP_PASSWORD "YourPassword"
